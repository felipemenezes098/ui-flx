ssName={`${imageClassName} order-3 aspect-[16/15] w-5/6 sm:w-3/5 lg:w-[85%]`}\n          >\n            <img\n              src=\"https://images.unsplash.com/photo-1586105251261-72a756497a11?q=80&w=1200&auto=format&fit=crop\"\n              alt=\"Alt 3\"\n              loading=\"lazy\"\n              decoding=\"async\"\n              className=\"size-full object-cover\"\n            />\n          </div>\n        </div>\n      </div>\n    </section>\n  )\n}\n",
