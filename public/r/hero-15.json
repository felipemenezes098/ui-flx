  "name": "hero-15",
  "title": "Hero 15",
  "description": "A directory-style hero with an oversized title, split intro with dual CTAs, and a row of wordmark cards with minimal imagery.",
  "dependencies": [
    "react-wrap-balancer"
  ],
  "registryDependencies": [
    "button"
